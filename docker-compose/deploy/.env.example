# Public application address (served by an external Nginx/Caddy reverse proxy)
APP_PORT=3210
APP_URL=http://localhost:3210
ALLOWED_ORIGINS=http://localhost:3210

# Generated by: pnpm docker:setup:deploy
AUTH_SECRET=__GENERATE_AUTH_SECRET__
KEY_VAULTS_SECRET=__GENERATE_KEY_VAULTS_SECRET__
JWKS_KEY=__GENERATE_JWKS_KEY__
CRON_SECRET=__GENERATE_CRON_SECRET__

# PostgreSQL
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=purechat
POSTGRES_USER=purechat
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__

# Redis
REDIS_IMAGE=redis:8.8.1-alpine
REDIS_PASSWORD=__GENERATE_REDIS_PASSWORD__
REDIS_MAXMEMORY=2gb

# RustFS
RUSTFS_IMAGE=rustfs/rustfs:latest
MC_IMAGE=minio/mc:latest
RUSTFS_ACCESS_KEY=__GENERATE_RUSTFS_ACCESS_KEY__
RUSTFS_SECRET_KEY=__GENERATE_RUSTFS_SECRET__
RUSTFS_BUCKET=purechat

# SearXNG
SEARXNG_IMAGE=searxng/searxng:latest
SEARXNG_SECRET=__GENERATE_SEARXNG_SECRET__

# At least one model provider is normally required.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AI_GATEWAY_API_KEY=
PURECHAT_API_KEY=
