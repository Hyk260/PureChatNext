# PureChatNext 生产域名（必须）*
# Vercel 部署时勿依赖 VERCEL_URL 预览域，否则 OAuth 回调与邮件链接会指向 *.vercel.app
APP_URL=""

# CORS 允许源，多个用逗号分隔（必须）*
# 生产环境勿使用 *，示例：https://next.purechat.cn,https://www.purechat.cn
ALLOWED_ORIGINS=""

# 指定 API 密钥选择方法：random（随机）或 turn（轮流）
# API_KEY_SELECT_MODE=random


# Better Auth 会话签名密钥（必须）*
# 生成方式: openssl rand -base64 32
AUTH_SECRET=""

# JWKS RSA 密钥，用于用户 JWT 签名 RS256（必须）*
# 生成方式: node scripts/generate-jwks-key.mjs
JWKS_KEY=""

# JWT 过期时间（格式: 数字 + 单位 s/m/h/d，默认 15m / 7d）
# JWT_ACCESS_EXPIRATION=15m
# JWT_REFRESH_EXPIRATION=7d

# SSO 提供商配置（Better Auth）
# 逗号分隔，支持：github, google, apple, wechat, feishu
# 登录页 UI 仅展示 github 与 wechat
AUTH_SSO_PROVIDERS=""

# Better Auth GitHub OAuth（启用 github SSO 时必传）
# 在 https://github.com/settings/developers 创建 OAuth App
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# 邮箱验证（需配置下方邮件服务，见 docs/self-hosting/auth/email.zh-CN.md）
# AUTH_EMAIL_VERIFICATION=1
# AUTH_EMAIL_VERIFICATION_MODE=otp
# AUTH_ENABLE_MAGIC_LINK=1


# 启用邮箱验证或魔法链接时必传
# 邮件服务提供商：nodemailer（SMTP，默认）或 resend

# EMAIL_SERVICE_PROVIDER=nodemailer

# --- Nodemailer / SMTP（Vercel 请使用 465 端口 + SMTP_SECURE=true，25 端口不可用）---
# SMTP_HOST=gz-smtp.qcloudmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@purechat.cn
# SMTP_PASS=your-smtp-password
# SMTP_FROM=PureChat <noreply@purechat.cn>

# --- Resend（备选）---
# EMAIL_SERVICE_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=noreply@your-domain.com


# 旧版 JWT 登录 / GitHub API 客户端（必须）*
# Github App 详情页: https://github.com/settings/apps/new
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Electron 客户端 GitHub OAuth（可选）
# GITHUB_ELECTRON_ID=""
# GITHUB_ELECTRON_SECRET=""


# 腾讯 IM SDKAppID（必须）*
# https://cloud.tencent.com/product/im
IM_SDK_APPID=""

# 腾讯 IM 密钥，敏感信息请勿泄露（必须）*
IM_SDK_KEY=""

# 腾讯 IM 管理员账号 ID（可选）
IM_ADMIN_ISTRATOR=""


# 数据库连接驱动模式（可选，默认 neon）
# neon — 云托管 Postgres，启用 SSL（Neon / Vercel Postgres / Supabase 等）
# node — 本地或无需 SSL 的 Postgres
# DATABASE_DRIVER=neon

# Postgres 数据库连接字符串（必须）*
# Supabase: Settings → Database → Connection string
# 生产环境推荐使用连接池（端口 6543）
DATABASE_URL=""

# 敏感信息加密密钥，API Key 哈希等（必须）*
# 生成方式: openssl rand -base64 32 或 https://generate-secret.vercel.app/32
KEY_VAULTS_SECRET=""

# Supabase 客户端配置（推荐）
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""


# 文件上传 / 头像存储（按需配置）
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET=pure-next-bucket
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1


# OpenAI API 密钥（推荐，聊天功能依赖）
OPENAI_API_KEY=""

# OpenAI 代理地址（可选）
# OPENAI_PROXY_URL=https://api.openai.com/v1

# DeepSeek API 密钥（可选）
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 自定义 OpenAI 模型列表，逗号分隔（可选）
# OPENAI_MODEL_LIST=gpt-4o-mini
