# 本机上传离线包用的 SSH 连接信息。
# 复制为同目录 upload.env 后填写（权限建议 600）。
# 也兼容旧文件名 .upload.env。
# 这些变量只给 `pnpm docker:upload` 使用，不要写入应用 .env / .env.local，
# 也不要加入 packages/env（不是运行时配置）。

# 必填：服务器 IP 或域名。也可写成 root@1.2.3.4
PURECHAT_SSH_HOST=

# 默认 root。1Panel 常用 root；非 root 需能免密 sudo，且 tar 会落到 /tmp
# PURECHAT_SSH_USER=root

# 自定义 SSH 端口时改这里；安全组必须放行该端口
# PURECHAT_SSH_PORT=22

# 推荐：私钥文件。文件权限保持 600，不要提交到 git
# PURECHAT_SSH_KEY_FILE=~/.ssh/id_ed25519

# 或者把私钥全文放进环境变量（PEM / OpenSSH）。不要打印、不要提交。
# 单行时可用 \n 表示换行。带口令的密钥请改用 ssh-add，不要写口令。
# PURECHAT_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----"

# 远端 tar 路径。root 默认 /opt/purechat-next-offline.tar；非 root 默认 /tmp/...
# PURECHAT_REMOTE_TAR=/opt/purechat-next-offline.tar

# 解压目录（--extract / --install / --up），不要有空格
# PURECHAT_HOME=/opt/purechat

# 首次连接默认 accept-new；确认指纹后可改为 yes
# PURECHAT_SSH_STRICT_HOST_KEY_CHECKING=accept-new

# 跳板机等额外 ssh 参数
# PURECHAT_SSH_EXTRA_OPTS=-J bastion.example.com
