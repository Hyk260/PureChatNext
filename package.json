{
  "name": "pure-chat-next",
  "version": "0.1.9",
  "scripts": {
    "dev": "bun scripts/dev-startup-sequence.mts",
    "dev:next": "next dev -p 3000",
    "dev:spa": "vite",
    "dev:inspect": "bun scripts/dev-startup-sequence.mts --inspect",
    "dev:docker": "bun scripts/docker.mts up",
    "dev:docker:down": "bun scripts/docker.mts down",
    "dev:docker:reset": "bun scripts/docker.mts reset",
    "clean": "bun scripts/clean-cache.mts",
    "build": "pnpm run build:spa && pnpm run build:spa:copy && pnpm run check:spa-env-leak && pnpm run build:next",
    "build:spa": "vite build",
    "build:spa:copy": "node scripts/copy-spa-build.mjs",
    "build:next": "next build",
    "build:docker:migrate": "esbuild scripts/docker-migrate.mjs --bundle --platform=node --format=esm --target=node22 --outfile=dist/docker-migrate.mjs",
    "build:docker:wechat-gateway": "esbuild scripts/wechat-gateway.ts --bundle --platform=node --format=esm --target=node22 --conditions=react-server --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/wechat-gateway.mjs",
    "build:docker": "pnpm run build:spa && pnpm run build:spa:copy && pnpm run check:spa-env-leak && next build && pnpm run build:docker:migrate && pnpm run build:docker:wechat-gateway",
    "vercel-build": "pnpm build",
    "start": "next start -p 3210",
    "gateway": "bun scripts/gateway.ts",
    "wechat:gateway": "bun --conditions=react-server scripts/wechat-gateway.ts",
    "qq:gateway": "bun scripts/qq-gateway.ts",
    "docker:setup:dev": "bun scripts/docker.mts setup-dev",
    "docker:setup:deploy": "bun scripts/docker.mts setup-deploy",
    "docker:validate": "bun scripts/docker.mts validate",
    "agents:sync": "bun scripts/fetch-community-agents.ts",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "pnpm run lint:ts && pnpm run lint:spa-env-imports && pnpm run lint:style && pnpm run typecheck && pnpm run lint:circular",
    "lint:ts": "eslint src/ tests/ --concurrency=auto",
    "lint:style": "stylelint \"{src,tests}/**/*.css\" --fix",
    "lint:spa-env-imports": "node scripts/check-spa-env-imports.mjs",
    "lint:circular": "pnpm run lint:circular:main && pnpm run lint:circular:packages",
    "lint:circular:main": "dpdm \"src/**/*.{ts,tsx}\" --no-warning --no-tree --no-progress --exit-code circular:1 --transform --skip-dynamic-imports circular",
    "lint:circular:packages": "dpdm \"packages/**/src/**/*.{ts,tsx}\" --no-warning --no-tree --no-progress --exit-code circular:1 --transform --skip-dynamic-imports circular",
    "lint:console": "tsx scripts/check-console-log.mts",
    "lint:md": "remark . --silent --output",
    "lint:unused": "knip --include files,exports,types,enumMembers,duplicates",
    "prettier": "prettier -c --write \"**/**\"",
    "check:spa-env-leak": "node scripts/check-spa-env-leak.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "pnpm -r --filter \"@pure/*\" exec tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.7",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/react": "^4.0.20",
    "@ant-design/icons": "^6.3.2",
    "@aws-sdk/client-s3": "~3.932.0",
    "@aws-sdk/s3-request-presigner": "~3.932.0",
    "@chat-adapter/state-memory": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@lobehub/icons": "^5.15.0",
    "@lobehub/ui": "^5.28.1",
    "@pure/chat-adapter": "workspace:*",
    "@pure/const": "workspace:*",
    "@pure/database": "workspace:*",
    "@pure/file-loaders": "workspace:*",
    "@pure/model-bank": "workspace:*",
    "@pure/types": "workspace:*",
    "@pure/ui": "workspace:*",
    "@pure/utils": "workspace:*",
    "@pure/web-crawler": "workspace:*",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.78.0",
    "@t3-oss/env-core": "^0.13.10",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@testing-library/react": "^16.3.2",
    "@types/nodemailer": "^8.0.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/edge-config": "^1.4.3",
    "@vercel/functions": "^3.2.0",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "7.0.19",
    "antd": "^6.4.5",
    "antd-style": "4.1.0",
    "axios": "^1.13.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.22",
    "chat": "^4.31.0",
    "debug": "^4.4.3",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "ioredis": "^5.11.1",
    "jose": "^6.1.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^1.23.0",
    "motion": "^12.41.0",
    "nanoid": "^5.1.6",
    "next": "^16.3.0",
    "nodemailer": "^9.0.1",
    "nuqs": "^2.9.0",
    "pg": "^8.17.2",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "postgres": "^3.4.7",
    "query-string": "^9.3.1",
    "random-words": "^2.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^8.2.0",
    "react-scan": "^0.5.7",
    "resend": "^6.16.0",
    "swr": "^2.4.2",
    "tls-sig-api-v2": "^1.0.2",
    "tsx": "^4.20.6",
    "ua-parser-js": "^1.0.41",
    "url-join": "^5.0.0",
    "virtua": "^0.49.2",
    "workflow": "4.0.1-beta.11",
    "zod": "^4.3.6",
    "zustand": "5.0.4",
    "zustand-utils": "^2.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/debug": "^4.1.12",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/devtools": "^0.4.12",
    "@vitejs/devtools-vite": "^0.4.12",
    "@vitejs/devtools-vitest": "^0.4.12",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "3.2.4",
    "code-inspector-plugin": "^2.0.1",
    "dpdm": "^4.2.0",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "knip": "^6.29.0",
    "mime": "^4.1.0",
    "p-map": "^7.0.4",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "raw-loader": "^4.0.2",
    "remark-cli": "^12.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "zod": "^4.3.6"
    }
  },
  "keywords": [
    "nextjs",
    "vercel-ai",
    "openai"
  ]
}
