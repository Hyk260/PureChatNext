# 复制为 .env.local 后按需取消注释。
# 完整说明：docs/self-hosting/configuration/environment.md
# 不要提交含密钥的 .env / .env.local。

########################################
# App
########################################

# 对外地址（better-auth baseURL、邮件 / OAuth 回调）
# 本地开发必须用 SPA 端口；邮件链接经 Vite 代理 /api → Next :3000
APP_URL=http://localhost:5174

# CORS 额外来源，逗号分隔。省略时使用 APP_URL（本地开发端口已内置）
# ALLOWED_ORIGINS=https://www.example.com

# 国内访问 GitHub 头像过慢或失败时，可指定镜像前缀（未设置时会走 avatars.githubusercontent.com / wsrv.nl）
# GITHUB_PROXY=https://ghfast.top/

# 加密敏感信息（渠道凭证、用户服务商 API Key / 代理地址、API key 哈希等）。生成：openssl rand -base64 32
# KEY_VAULTS_SECRET=

# Vercel Cron / 内部定时任务鉴权（Authorization: Bearer …）
# 生成：openssl rand -base64 32
# 本地手动调用：curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/cron/cleanup-unverified-users
# CRON_SECRET=

########################################
# Local Development
########################################

# code-inspector（Alt+Shift 点击元素跳转 IDE）。默认关闭；会加重编译与内存占用
# 临时开启：pnpm dev:inspect
# CODE_INSPECTOR=1

# Vite DevTools（浮动面板 / build 分析）。临时：VITE_DEVTOOLS=1 pnpm dev:spa
# VITE_DEVTOOLS=1

# 强制弹出 SPA 部署更新提示。也可打开 ?spaUpdatePreview=1
# VITE_SPA_UPDATE_PREVIEW=1

# cloudflared TryCloudflare 隧道（Vite Host + Better Auth / CORS Origin）
# 临时：ALLOW_TRYCLOUDFLARE=1 pnpm dev
# ALLOW_TRYCLOUDFLARE=1

########################################
# Auth
########################################

# Better Auth 会话签名密钥。生成：openssl rand -base64 32（生产必填）
# AUTH_SECRET=

# JWKS RSA 密钥（用户 JWT 签名，RS256）。生成：bun scripts/generate-jwks-key.ts（生产必填）
# JWKS_KEY='{"keys":[...]}'

# JWT 过期时间（数字 + s/m/h/d，默认 15m / 7d）
# JWT_ACCESS_EXPIRATION=15m
# JWT_REFRESH_EXPIRATION=7d

# 已启用的 OAuth 提供商，逗号分隔：github, google, apple, wechat, feishu
# 登录页 UI 目前仅展示 github 与 wechat
# AUTH_SSO_PROVIDERS=github,wechat

# GitHub SSO（Better Auth；与下方 GITHUB_CLIENT_ID 不是同一组）
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# 微信 OAuth 登录（与下方 iLink 渠道不是同一组）
# AUTH_WECHAT_ID=
# AUTH_WECHAT_SECRET=

# 其他 SSO：AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET、AUTH_APPLE_CLIENT_*、AUTH_FEISHU_APP_*

# 禁用邮箱密码注册（仅允许 SSO）
# AUTH_DISABLE_EMAIL_PASSWORD=1

# 邮箱验证（需配置邮件服务，见 docs/self-hosting/auth/email.md）
# AUTH_EMAIL_VERIFICATION=1
# otp（6 位验证码，默认）或 link（邮件链接）
# AUTH_EMAIL_VERIFICATION_MODE=otp

# 魔法链接免密登录（需配置邮件服务）
# AUTH_ENABLE_MAGIC_LINK=1

########################################
# Email
########################################

# nodemailer（SMTP，默认）或 resend
# 完整配置见 docs/self-hosting/auth/email.md
# EMAIL_SERVICE_PROVIDER=nodemailer

# --- SMTP（推荐：腾讯云邮件推送）---
# 广州区: gz-smtp.qcloudmail.com | 香港区: smtp.qcloudmail.com
# Vercel 请用 465 + SMTP_SECURE=true（25 端口不可用）
# SMTP_HOST=gz-smtp.qcloudmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@purechat.cn
# SMTP_PASS=
# SMTP_FROM=PureChat <noreply@purechat.cn>

# --- SMTP（本地开发：QQ 邮箱）---
# mail.qq.com → 设置 → 账户 开启 SMTP，使用授权码（非 QQ 登录密码）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=123456789@qq.com
# SMTP_PASS=
# SMTP_FROM=PureChat <123456789@qq.com>

# --- Resend ---
# EMAIL_SERVICE_PROVIDER=resend
# RESEND_API_KEY=re_
# RESEND_FROM=noreply@your-domain.com

########################################
# GitHub App / Desktop
########################################

# GitHub App OAuth（GitHub API 集成，非 Better Auth SSO）
# https://github.com/settings/apps/new
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Electron 客户端 GitHub OAuth
# GITHUB_ELECTRON_ID=
# GITHUB_ELECTRON_SECRET=

# 打包后 Electron 客户端的默认远端后端
# PURECHAT_DESKTOP_REMOTE_URL=

########################################
# Tencent IM
########################################

# 管理员账号 id
# IM_ADMIN_ISTRATOR=administrator
# IM_SDK_APPID=
# IM_SDK_KEY=
# IM_SERVER_BASE_URL=https://console.tim.qq.com
# IM_REQUEST_TIMEOUT=10000

########################################
# S3
########################################

# 完整说明见 docs/self-hosting/configuration/environment.md「S3 对象存储」
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=pure-next-bucket
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-west-1
# 单用户存储额度（MB），默认 15
# FILE_STORAGE_LIMIT_MB=15
# 预签名 URL 过期秒数，默认 7200
# S3_PREVIEW_URL_EXPIRE_IN=7200

# 上传时是否设置 ACL=public-read
# 1 → 对象公开可读，客户端直链 S3
# 0 → 对象私有，经应用鉴权代理（推荐；RustFS / 私有桶必用）
# S3_SET_ACL=0

# Path-style 访问（MinIO / RustFS 通常需要）。腾讯云 COS 用 virtual-hosted，保持 0
# S3_ENABLE_PATH_STYLE=1

# 自定义访问域名（COS 自定义源站 / CDN）。只用于拼浏览器 URL，不能当作 S3_ENDPOINT
# 头像会变成 https://cdn.example.com/user/avatar/<userId>/<file>，需桶策略允许匿名 GetObject
# S3_PUBLIC_DOMAIN=https://cdn.purechat.cn

# 腾讯云 COS（S3 兼容）。自定义域名只能用于浏览器访问，不能作为 S3_ENDPOINT
# S3_ACCESS_KEY_ID=<SecretId>
# S3_SECRET_ACCESS_KEY=<SecretKey>
# S3_BUCKET=<bucket>-<APPID>
# S3_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
# S3_REGION=ap-shanghai
# S3_ENABLE_PATH_STYLE=0
# S3_SET_ACL=0

# 本地 Docker RustFS（pnpm dev:docker）推荐：
# S3_ACCESS_KEY_ID=purechat
# S3_SECRET_ACCESS_KEY=123456qwer
# S3_BUCKET=purechat
# S3_ENDPOINT=http://localhost:9000
# S3_ENABLE_PATH_STYLE=1
# S3_SET_ACL=0
# 密钥/桶名需与 docker-compose/dev/.env 中 RUSTFS_* 一致。
# 生产 Docker 请填写对象存储 Endpoint 与密钥，不要使用这些 localhost 地址。
# 见 docs/self-hosting/platform/docker.md

########################################
# Database
########################################

# neon — 云托管 Postgres（Neon、Supabase 生产等），强制 SSL
# node — 本地 / Docker / 内网，无需 SSL
# DATABASE_DRIVER=neon
# DATABASE_URL=postgres://username:password@host:port/database

# 本地 Docker Compose（pnpm dev:docker）推荐：
# DATABASE_DRIVER=node
# DATABASE_URL=postgresql://purechat:purechat@127.0.0.1:5432/purechat
# 密码需与 docker-compose/dev/.env 中 POSTGRES_PASSWORD 一致。
# 生产 Docker：install.sh 连接宿主机 PostgreSQL 用户 purechat，不要写公网数据库地址。

########################################
# Redis
########################################

# 自托管连接字符串。pnpm dev:docker：
# REDIS_URL=redis://127.0.0.1:6379
# Compose 网络内可用：redis://redis:6379
# 生产 install.sh 可选用宿主机 Redis（ACL 用户 purechat，或实例密码 + REDIS_PREFIX）。不要开放公网 6379。

# REDIS_DATABASE=0
# REDIS_USERNAME=default
# REDIS_PASSWORD=
# 连接托管 Redis 或 rediss:// 时设为 1
# REDIS_TLS=1
# REDIS_PREFIX=purechat
# 即使配置了 REDIS_URL 也禁用 Redis
# DISABLE_REDIS=1

########################################
# Search / Crawler
########################################

# 完整说明见 docs/self-hosting/features/online-search.md
# SEARCH_PROVIDERS=searxng
# SEARXNG_URL=http://localhost:8180
# CRAWLER_IMPLS=naive,jina
# CRAWL_CONCURRENCY=3
# CRAWLER_RETRY=1

# 国内网络访问 Jina 时设为 true（仅接受 true/false，不是 1/0）
# JINA_USE_CN_DOMAINS=true

# SEARXNG_SECRET 由 docker-compose 读取，请写在 docker-compose/dev/.env
# 生成：openssl rand -hex 32

########################################
# Channel Gateway
########################################

# 微信：docs/self-hosting/channels/wechat/setup.md
# QQ：docs/self-hosting/channels/qq/setup.md

# 内置 Gateway 总开关。本地默认关闭；Docker Compose 已显式开启；Vercel 强制关闭。
# CHANNEL_GATEWAY_ENABLED=1
# CHANNEL_GATEWAY_INTERNAL_URL=http://127.0.0.1:3000
# CHANNEL_GATEWAY_INTERNAL_SECRET=

# 入站消息日志：DEBUG=channel:wechat:webhook（或 channel:wechat:*）
# 默认静默 QQ/微信 status、qrcode 轮询的 Next access log；排查时设为 1 并重启 Next
# NEXT_LOG_CHANNEL_POLLS=1

# App ID / Secret 按绑定加密存库（KEY_VAULTS_SECRET），无全局 QQ_APP_SECRET
# 回复消息使用下方服务端模型密钥，非浏览器 localStorage
# 旧变量 WECHAT_GATEWAY_ENABLED / WECHAT_WEBHOOK_SECRET / QQ_WEBHOOK_SECRET 仍兼容读取，请改用上方统一变量。

########################################
# AI Providers
########################################

# API Key 选择：random（随机）或 turn（轮流）
# API_KEY_SELECT_MODE=random

# Vercel AI Gateway（服务端 Key，不对用户暴露）
# AI_GATEWAY_API_KEY=vck_
# 与 AI_GATEWAY_API_KEY 二选一
# PURECHAT_API_KEY=vck_
# PURECHAT_ENABLED=1
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# OpenAI
# OPENAI_API_KEY=sk-

# DeepSeek
# DEEPSEEK_API_KEY=
