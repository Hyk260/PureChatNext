# Electron / electron-builder 二进制走 npmmirror，避免 GitHub releases 下载过慢或失败。
# 注意：打包时还需 electron-builder.mjs 显式设置 ELECTRON_BUILDER_BINARIES_MIRROR，
# 因为 pnpm 不会把本文件的 electron_builder_binaries_mirror 注入进 electron-builder 进程。
shamefully-hoist=true
ignore-workspace-root-check=true

electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
