# 本地 Docker Compose 环境变量。
# 启动服务前请运行：
#   pnpm docker:setup:dev
# 该命令会生成本目录下的 .env，并替换所有 __GENERATE_*__ 凭证。
#
# 请与仓库根目录 .env.local 保持一致
#（DATABASE_URL / S3_* / SEARXNG_URL）。

# PostgreSQL
POSTGRES_DB=purechat
POSTGRES_USER=purechat
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_MAXMEMORY=384mb

# RustFS（S3 兼容对象存储）
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
RUSTFS_ACCESS_KEY=__GENERATE_RUSTFS_ACCESS_KEY__
RUSTFS_SECRET_KEY=__GENERATE_RUSTFS_SECRET__
RUSTFS_BUCKET=purechat

# SearXNG（联网搜索）
SEARXNG_PORT=8180
SEARXNG_SECRET=__GENERATE_SEARXNG_SECRET__

# 开发服务默认只绑定本机回环地址（127.0.0.1）
DOCKER_BIND_ADDRESS=127.0.0.1
