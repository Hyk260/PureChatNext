# Local Docker Compose env.
# Copy to .env in this directory before starting services:
#   cp docker-compose/dev/.env.example docker-compose/dev/.env
#
# Keep these values aligned with the app root .env.local
# (DATABASE_URL / S3_* / SEARXNG_URL).

# Postgres
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=purechat
POSTGRES_USER=purechat
POSTGRES_PASSWORD=purechat
POSTGRES_PORT=5432

# Redis
REDIS_IMAGE=redis:8.8.1-alpine
REDIS_PORT=6379
REDIS_MAXMEMORY=2gb

# RustFS (S3-compatible)
RUSTFS_IMAGE=rustfs/rustfs:latest
MC_IMAGE=minio/mc:latest
RUSTFS_PORT=9000
RUSTFS_ADMIN_PORT=9001
RUSTFS_ACCESS_KEY=purechat
RUSTFS_SECRET_KEY=purechat_secret
RUSTFS_BUCKET=purechat

# SearXNG
SEARXNG_IMAGE=searxng/searxng:latest
SEARXNG_PORT=8180

# Development services are only exposed on loopback by default.
DOCKER_BIND_ADDRESS=127.0.0.1
