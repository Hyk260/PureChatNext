########################################
############ App Service ###############
########################################

# PureChatNext 域名
# APP_URL=http://localhost:3000

# 指定 API 密钥选择方法，目前支持random（随机）和turn（轮流）
# API_KEY_SELECT_MODE=random

# 本地开发：是否启用 code-inspector（点击页面元素跳转源码）
# 设为 1 开启；默认关闭。开启会加重 Turbopack 编译与内存占用，电脑卡顿时请保持关闭
# 也可用临时命令开启，无需改本文件：pnpm dev:inspect
# CODE_INSPECTOR=1

########################################
############ Auth Service ##############
########################################

# JWKS RSA 密钥（用于用户 JWT 签名，RS256）
# 生成方式: node scripts/generate-jwks-key.mjs
# JWKS_KEY='{"keys":[...]}'

# JWT 过期时间（格式: 数字 + 单位 s/m/h/d，默认 15m / 7d）
# JWT_ACCESS_EXPIRATION=15m
# JWT_REFRESH_EXPIRATION=7d

# Better Auth 会话签名密钥 (生成方式: openssl rand -base64 32)
# AUTH_SECRET=your_auth_secret
# SSO 提供商配置（Better-Auth）
# 逗号分隔的已启用 OAuth 提供商列表
# 支持的提供商： github, google, apple, wechat, feishu
# 登录页 UI 仅展示 github 与 wechat
# 示例：AUTH_SSO_PROVIDERS=github,wechat
# AUTH_SSO_PROVIDERS=github,wechat

# 禁用用户注册（仅允许 SSO 登录）
# 设置为 1 后，用户无法通过邮箱密码注册，只能通过 SSO 登录
# AUTH_DISABLE_EMAIL_PASSWORD=1

# 邮箱验证（需配置邮件服务，见 docs/self-hosting/auth/email.zh-CN.md）
# 设置为 1 要求注册后验证邮箱，未验证用户无法密码登录
# AUTH_EMAIL_VERIFICATION=1
# 注册验证方式：otp（6 位验证码，默认）或 link（邮件链接）
# AUTH_EMAIL_VERIFICATION_MODE=otp

# 魔法链接免密登录（需配置邮件服务）
# AUTH_ENABLE_MAGIC_LINK=1

########################################
########### Email Service ##############
########################################

# 邮件服务提供商：nodemailer（SMTP，默认）或 resend
# 完整配置说明见 docs/self-hosting/auth/email.zh-CN.md

# EMAIL_SERVICE_PROVIDER=nodemailer

# --- Nodemailer / SMTP（推荐：腾讯云邮件推送）---
# 广州区: gz-smtp.qcloudmail.com | 香港区: smtp.qcloudmail.com
# Vercel 部署请使用 465 端口 + SMTP_SECURE=true（25 端口不可用）
# SMTP_HOST=gz-smtp.qcloudmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@purechat.cn
# SMTP_PASS=your-smtp-password-from-tencent-console
# SMTP_FROM=PureChat <noreply@purechat.cn>

# --- Nodemailer / SMTP（本地开发：QQ 邮箱）---
# 在 mail.qq.com → 设置 → 账户 开启 POP3/SMTP，生成授权码（非 QQ 登录密码）
# EMAIL_SERVICE_PROVIDER=nodemailer
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=123456789@qq.com
# SMTP_PASS=your-qq-smtp-auth-code
# SMTP_FROM=PureChat <123456789@qq.com>

# --- Resend（备选）---
# EMAIL_SERVICE_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=noreply@your-domain.com

########################################
########### Github Service #############
########################################

# Github App 详情页的 客户端 ID https://github.com/settings/apps/new
# GITHUB_CLIENT_ID=github_client_id

# Github App 详情页的 客户端 Secret
# GITHUB_CLIENT_SECRET=github_client_secret

# github client id electron
# GITHUB_ELECTRON_ID=""

# github Client secret electron
# GITHUB_ELECTRON_SECRET=""

########################################
########## IM Tencent Service ##########
########################################

# 腾讯IM 管理员账号id (可选)
# IM_ADMIN_ISTRATOR=administrator

# 腾讯IM SDKAppID https://cloud.tencent.com/product/im (必须)*
# IM_SDK_APPID=123456

# 腾讯IM密钥 密钥信息为敏感信息，请注意保密，不要泄露。(必须)*
# IM_SDK_KEY=asdfghjkl

# Your im server baseurl
# IM_SERVER_BASE_URL=https://console.tim.qq.com

# #######################################
# #### S3 Object Storage Service ########
# #######################################

# S3 密钥
# S3_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 存储桶名称
# S3_BUCKET=pure-next-bucket

# 存储桶请求端点
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# 存储桶区域，如 us-west-1，通常无需配置
# 但部分服务商可能要求设置
# S3_REGION=us-west-1

# 是否设置 S3 对象 ACL
# S3_SET_ACL=1

########################################
########## Server Database #############
########################################

# Postgres 相关，也即 DB 必须的环境变量

# 数据库连接驱动模式，控制 postgres-js 是否启用 SSL（默认 neon）
# 可选值：
#   neon — 云托管 Postgres（Neon、Vercel Postgres、Supabase 生产环境等），强制 SSL
#   node — 本地或无需 SSL 的 Postgres（Docker、localhost、内网直连）
# DATABASE_DRIVER=neon

# 用于加密敏感信息的密钥，可以使用 https://generate-secret.vercel.app/32 or `openssl rand -base64 32` 生成
# KEY_VAULTS_SECRET=xxxxx/xxxxxxxxxxxxxx=

# Postgres 数据库连接字符串 here: https://vercel.com/docs/postgres
# DATABASE_URL=postgres://username:password@host:port/database

# #######################################
# ########### Redis Settings ############
# #######################################

# 自托管 Redis 连接字符串（Docker/K8s/托管服务）。通过 docker-compose 运行时请使用容器主机名。
# REDIS_URL=redis://localhost:6379

# 可选的数据库索引。
# REDIS_DATABASE=0

# 托管 Redis 的可选认证信息。
# REDIS_USERNAME=default
# REDIS_PASSWORD=yourpassword

# 设为 '1' 时强制使用 TLS（连接托管 Redis 或 rediss:// 端点时）。
# REDIS_TLS=0

# 缓存/队列 key 的命名空间前缀。
# REDIS_PREFIX=purechat

# 设为任意非空值时强制禁用 Redis（即使配置了 REDIS_URL）。
# DISABLE_REDIS=1

########################################
########## AI Provider Service #########
########################################

### OpenAI ###

# you openai api key
# OPENAI_API_KEY=sk-xxxxxxxxx

# 使用代理连接 OpenAI API
# OPENAI_PROXY_URL=https://api.openai.com/v1

# 添加您的自定义模型名称，多个模型之间用逗号分隔. 例如 gpt-3.5,gpt-4
# OPENAI_MODEL_LIST=gpt-3.5-turbo

### DeepSeek AI  ####

# DEEPSEEK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DEEPSEEK_PROXY_URL=https://api.deepseek.com/v1
