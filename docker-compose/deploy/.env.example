# 应用对外地址（由宿主机 Nginx / Caddy 反代）
APP_PORT=3210
# 默认 127.0.0.1；临时公网 IP 访问用 0.0.0.0（见 start-ip.sh）
APP_BIND_ADDRESS=127.0.0.1
APP_URL=http://localhost:3210
# CORS 额外来源，逗号分隔。省略时使用 APP_URL
# ALLOWED_ORIGINS=https://www.example.com

# 在线安装应用镜像（install-online.sh / --online；离线包可忽略）
# PURECHAT_IMAGE=ghcr.io/hyk260/purechat-next:latest

# 由 pnpm docker:setup:deploy 或 install.sh 自动生成，不要改回占位符
AUTH_SECRET=__GENERATE_AUTH_SECRET__
KEY_VAULTS_SECRET=__GENERATE_KEY_VAULTS_SECRET__
JWKS_KEY=__GENERATE_JWKS_KEY__
CRON_SECRET=__GENERATE_CRON_SECRET__

# PostgreSQL（必须）。install.sh 会在已运行的 Postgres 容器中创建用户和数据库 purechat。
# 容器名可用 POSTGRES_CONTAINER 指定，默认自动检测 postgresql。
POSTGRES_DB=purechat
POSTGRES_USER=purechat
POSTGRES_PASSWORD=__GENERATE_POSTGRES_PASSWORD__
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
# POSTGRES_CONTAINER=postgresql

# Redis（可选）。检测到 Redis 容器时 install.sh 会创建 ACL 用户 purechat；没有则留空 REDIS_URL。
REDIS_PREFIX=purechat
REDIS_PASSWORD=__GENERATE_REDIS_PASSWORD__
REDIS_USERNAME=
REDIS_URL=
# REDIS_CONTAINER=redis
# DISABLE_REDIS=1

# 对象存储（S3 兼容）。生产不内置对象存储服务。
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_DOMAIN=
S3_REGION=
S3_ENABLE_PATH_STYLE=0
S3_SET_ACL=0
S3_AUTO_CREATE_BUCKET=0

# 联网搜索（可选）。生产不内置搜索服务；可填 tavily / brave / search1api 等。
SEARCH_PROVIDERS=
SEARXNG_URL=

# 构建镜像时的可选参数
USE_CN_MIRROR=false
NPM_REGISTRY=

# 默认资源上限（profiles/2g.env）
NODE_MAX_OLD_SPACE_SIZE=320
APP_MEMORY_LIMIT=512m
APP_CPUS=1.0
APP_PIDS_LIMIT=256

# 通常至少配置一个模型 Provider 密钥
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
AI_GATEWAY_API_KEY=
PURECHAT_API_KEY=
