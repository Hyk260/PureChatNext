{
  "name": "pure-chat-next",
  "version": "0.2.5",
  "description": "把 AI 助手接入 Web、微信与 QQ 的开源自托管平台，支持多模型、联网搜索、文件处理和私有部署。",
  "homepage": "https://next.purechat.cn",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hyk260/PureChatNext.git"
  },
  "bugs": {
    "url": "https://github.com/Hyk260/PureChatNext/issues"
  },
  "author": "Hyk260",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev-startup-sequence.mts",
    "dev:next": "next dev -p 3000",
    "dev:spa": "vite",
    "dev:desktop": "bun scripts/dev-desktop.mts",
    "dev:docs": "pnpm --filter @pure/docs dev",
    "dev:inspect": "bun scripts/dev-startup-sequence.mts --inspect",
    "dev:docker": "bun scripts/docker.mts up",
    "dev:docker:down": "bun scripts/docker.mts down",
    "dev:docker:reset": "bun scripts/docker.mts reset",
    "clean": "bun scripts/clean-cache.mts",
    "build": "pnpm run build:spa && pnpm run build:spa:copy && pnpm run check:spa-env-leak && pnpm run build:next",
    "build:spa": "vite build",
    "build:spa:copy": "node scripts/copy-spa-build.mjs",
    "build:next": "next build",
    "build:desktop": "pnpm --filter purechat-desktop build",
    "package:desktop": "pnpm --filter purechat-desktop package:dir",
    "package:desktop:mac": "pnpm --filter purechat-desktop package:mac",
    "package:desktop:win": "pnpm --filter purechat-desktop package:win",
    "package:desktop:win:portable": "pnpm --filter purechat-desktop package:win:portable",
    "build:docs": "pnpm --filter @pure/docs build",
    "build:docker:migrate": "node scripts/build-docker-migrate.mjs",
    "build:docker": "pnpm run build && pnpm run build:docker:migrate",
    "build:vercel": "pnpm build",
    "start": "next start -p 3210",
    "preview:prod": "bun --no-env-file scripts/preview-prod.mts",
    "gateway": "bun scripts/gateway.ts",
    "docker:setup:dev": "bun scripts/docker.mts setup-dev",
    "docker:setup:deploy": "bun scripts/docker.mts setup-deploy",
    "docker:deploy": "bun scripts/docker.mts deploy",
    "docker:validate": "bun scripts/docker.mts validate",
    "docker:verify:local": "bun scripts/docker-verify-local.mts",
    "agents:sync": "bun scripts/fetch-community-agents.ts",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "tunnel:cloudflare": "cloudflared tunnel --url http://localhost:5174 --protocol http2",
    "tunnel:ngrok": "ngrok http http://localhost:5174",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "node scripts/run-parallel.mjs lint:ts lint:spa-env-imports lint:style lint:circular lint:docs lint:docs-site lint:md && pnpm run typecheck && pnpm run typecheck:docs",
    "lint:ts": "eslint src/ tests/ --concurrency=auto",
    "lint:style": "stylelint \"{src,tests}/**/*.css\"",
    "lint:style:fix": "stylelint \"{src,tests}/**/*.css\" --fix",
    "lint:spa-env-imports": "node scripts/check-spa-env-imports.mjs",
    "lint:circular": "node scripts/run-parallel.mjs lint:circular:main lint:circular:packages",
    "lint:circular:main": "dpdm \"src/**/*.{ts,tsx}\" --no-warning --no-tree --no-progress --exit-code circular:1 --transform --skip-dynamic-imports circular",
    "lint:circular:packages": "dpdm \"packages/**/src/**/*.{ts,tsx}\" --no-warning --no-tree --no-progress --exit-code circular:1 --transform --skip-dynamic-imports circular",
    "lint:console": "tsx scripts/check-console-log.mts",
    "lint:docs": "node scripts/check-docs.mjs",
    "lint:docs-site": "pnpm --filter @pure/docs lint",
    "test:docs-site": "pnpm --filter @pure/docs test",
    "lint:md": "remark . --silent --frail",
    "lint:md:fix": "remark . --silent --output",
    "lint:unused": "knip --include files,exports,types,enumMembers,duplicates",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "check:spa-env-leak": "node scripts/check-spa-env-leak.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:docs": "pnpm --filter @pure/docs types:check",
    "typecheck:packages": "pnpm -r --filter \"@pure/*\" exec tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.7",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/react": "^4.0.20",
    "@ant-design/icons": "^6.3.2",
    "@aws-sdk/client-s3": "~3.1114.0",
    "@aws-sdk/s3-request-presigner": "~3.1114.0",
    "@base-ui/react": "^1.7.0",
    "@chat-adapter/state-memory": "^4.0.0",
    "@emotion/react": "^11.14.0",
    "@lobehub/icons": "^5.15.0",
    "@lobehub/ui": "^5.32.3",
    "@pure/chat-adapter": "workspace:*",
    "@pure/const": "workspace:*",
    "@pure/database": "workspace:*",
    "@pure/file-loaders": "workspace:*",
    "@pure/model-bank": "workspace:*",
    "@pure/types": "workspace:*",
    "@pure/ui": "workspace:*",
    "@pure/utils": "workspace:*",
    "@pure/web-crawler": "workspace:*",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.112.3",
    "@t3-oss/env-core": "^0.13.10",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@testing-library/react": "^16.3.2",
    "@types/nodemailer": "^8.0.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/edge-config": "^1.4.3",
    "@vercel/functions": "^3.2.0",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "7.0.19",
    "antd": "^6.4.5",
    "antd-style": "4.1.0",
    "axios": "1.18.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.6.22",
    "chat": "^4.31.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "debug": "^4.4.3",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.50.0",
    "hono": "^4.12.30",
    "ioredis": "^5.11.1",
    "jose": "^6.1.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.41.0",
    "nanoid": "^5.1.16",
    "next": "^16.3.1",
    "nodemailer": "^9.0.1",
    "nuqs": "^2.9.0",
    "pg": "^8.17.2",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "postgres": "^3.4.9",
    "query-string": "^9.3.1",
    "random-words": "^2.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "^8.3.0",
    "resend": "^6.16.0",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "tls-sig-api-v2": "^1.0.2",
    "tsx": "^4.20.6",
    "ua-parser-js": "^1.0.41",
    "undici": "6.21.1",
    "url-join": "^5.0.0",
    "virtua": "^0.49.2",
    "zod": "^4.3.6",
    "zustand": "5.0.4",
    "zustand-utils": "^2.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/debug": "^4.1.12",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ua-parser-js": "^0.7.39",
    "@vitejs/devtools": "^0.4.12",
    "@vitejs/devtools-vite": "^0.4.12",
    "@vitejs/devtools-vitest": "^0.4.12",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "3.2.4",
    "code-inspector-plugin": "^2.0.1",
    "dpdm": "^4.2.0",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "knip": "^6.29.0",
    "mime": "^4.1.0",
    "p-map": "^7.0.4",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "raw-loader": "^4.0.2",
    "remark-cli": "^12.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "5.11.0",
      "framer-motion": "12.41.0",
      "js-cookie": "^3.0.7",
      "lodash": "^4.18.0",
      "motion": "12.41.0",
      "zod": "^4.3.6"
    },
    "ignoredBuiltDependencies": [
      "electron-winstaller"
    ]
  },
  "keywords": [
    "ai",
    "ai-chat",
    "self-hosted",
    "wechat",
    "qq-bot",
    "llm",
    "chatbot",
    "nextjs",
    "vercel-ai",
    "openai",
    "deepseek"
  ]
}
